# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ─────────────────────────────────────────────────
# Generate a strong secret in production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-before-deploying-to-production

# ── Client ──────────────────────────────────────────────
# Set to your frontend origin for CORS
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── CORS ─────────────────────────────────────────────────
# Frontend URL for CORS preflight requests (replaces CLIENT_URL if set)
# For production, set to your actual frontend domain
CORS_ORIGIN=http://localhost:5173

# ── Email (Resend) ──────────────────────────────────────
# Get your API key from: https://resend.com
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=noreply@yourdomain.com
