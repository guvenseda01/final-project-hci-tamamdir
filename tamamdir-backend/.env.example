# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ─────────────────────────────────────────────────
# Generate a strong secret in production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-before-deploying-to-production

# ── Client ──────────────────────────────────────────────
# Set to your frontend origin for CORS
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://tamamdir:tamamdir@localhost:5432/tamamdir

# ── Email (Resend) ──────────────────────────────────────
EMAIL_PROVIDER=resend
# Get your API key from: https://resend.com
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Tamamdır <noreply@yourdomain.com>
EMAIL_FROM=noreply@yourdomain.com

# ── Admin ───────────────────────────────────────────────
# Comma-separated emails that receive is_admin on registration
ADMIN_EMAILS=muleyke.kilic2003@gmail.com
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_VERIFICATION_SECRET=change-me-before-deploying-to-production
