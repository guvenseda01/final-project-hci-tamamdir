# Web app — lokal geliştirme (tamamdir-web-app npm run dev, varsayılan 5173)
VITE_WEB_APP_URL=http://localhost:5173

# Mobil — domain deploy: aynı sitede /mobile
VITE_MOBILE_APP_URL=/mobile

# Production örnekleri (deploy sonrası):
# VITE_WEB_APP_URL=https://tamamdir.com/app
# VITE_MOBILE_APP_URL=https://tamamdir.com/mobile
# veya subdomain:
# VITE_WEB_APP_URL=https://app.tamamdir.com
